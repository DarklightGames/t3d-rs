// Grammar for a single line of T3D text.
//
// T3D (and UnrealScript `defaultproperties`) is line-oriented: the importer in
// `importer.rs` splits the input into lines, recognises `Begin`/`End` lines
// itself, and parses every other line with the `line` rule. When a line fails
// to parse in full, `line_prefix` is used to salvage a complete statement at
// the start of the line. Comments are blanked out before lines reach this
// grammar, so it never sees them.

WS = _{ " " | "\t" }
id_char = _{ ASCII_ALPHANUMERIC | "_" }
id = @{ id_char+ }
sign = _{ "+" | "-" }

// Numbers may not run into identifier characters or further dots, so that
// tokens like `20_seconds`, `2DLoftSIDE` or `0.0.5` are not split up.
exponent = _{ ^"e" ~ sign? ~ ASCII_DIGIT+ }
float = @{
    sign? ~ (
        (ASCII_DIGIT+ ~ "." ~ ASCII_DIGIT* ~ exponent?) |
        ("." ~ ASCII_DIGIT+ ~ exponent?) |
        (ASCII_DIGIT+ ~ exponent)
    ) ~ !(id_char | ".")
}
int = @{ sign? ~ ASCII_DIGIT+ ~ !(id_char | ".") }

// Strings end at the closing quote or the end of the line. A backslash escapes
// the following character; the raw (unescaped) contents are kept.
string_inner = @{ (("\\" ~ ANY) | (!("\"" | "\\") ~ ANY))* }
string = ${ "\"" ~ string_inner ~ "\"" }

// `Texture'Pkg.Tex'`; whitespace is allowed before the quote (`Texture 'Pkg.Tex'`).
reference_path = @{ (!"'" ~ ANY)+ }
reference = ${ id ~ WS* ~ "'" ~ reference_path ~ "'" }

// `'SomeName'` or `''`
name_inner = @{ (!"'" ~ ANY)* }
name = ${ "'" ~ name_inner ~ "'" }

// Any other unquoted token, e.g. `None`, `true`, `ROLE_Authority`,
// `idle-empty`, `20_seconds` or `Package.Class.SubObject`.
bare = @{ (!(WS | "," | "(" | ")" | "\"" | "'" | ";" | "=") ~ ANY)+ }

struct_ = { "(" ~ WS* ~ (assignment ~ (WS* ~ "," ~ WS* ~ assignment)* ~ (WS* ~ ",")?)? ~ WS* ~ ")" }
array_element = { value? }
array = { "(" ~ WS* ~ array_element ~ (WS* ~ "," ~ WS* ~ array_element)* ~ WS* ~ ")" }

// A bare token directly followed by a quote is a broken reference
// (`Texture'Pkg.Tex` with no closing quote), not an identifier.
value = { struct_ | array | float | int | string | reference | name | (bare ~ !"'") }

index_value = { int | id }
index = _{ ("(" ~ WS* ~ index_value ~ WS* ~ ")") | ("[" ~ WS* ~ index_value ~ WS* ~ "]") }
assignment = { id ~ index? ~ WS* ~ "=" ~ WS* ~ value? }

// `Origin -00512.000000,+00256.000000,+00000.000000`
vector_number = _{ float | int }
vector_line = { id ~ WS+ ~ vector_number ~ (WS* ~ "," ~ WS* ~ vector_number)* }

// `Pan U=57 V=99`
inline_struct = { id ~ WS+ ~ assignment ~ (WS+ ~ assignment)* }

statement = { assignment | vector_line | inline_struct }
terminator = _{ (WS* ~ ";")* ~ WS* }

line = { SOI ~ WS* ~ statement ~ terminator ~ EOI }
line_prefix = { SOI ~ WS* ~ statement }

begin = { ^"begin" ~ WS+ ~ id ~ (WS+ ~ assignment)* }
begin_line = { SOI ~ WS* ~ begin ~ terminator ~ EOI }
begin_prefix = { SOI ~ WS* ~ begin }

end = { ^"end" ~ WS+ ~ id }
end_line = { SOI ~ WS* ~ end ~ terminator ~ EOI }
end_prefix = { SOI ~ WS* ~ end }
